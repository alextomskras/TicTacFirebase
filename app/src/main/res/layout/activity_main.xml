<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@color/whitebackground"
              android:orientation="vertical"

              tools:context=".MainActivity">

    <!-- Верхняя панель с кнопками действий -->
    <LinearLayout
            android:layout_margin="10pt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <EditText
                android:id="@+id/etEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                android:hint="@string/other_player_email"
                android:inputType="textEmailAddress"
                android:importantForAutofill="no" />

        <Button
                android:id="@+id/burequest"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="3pt"
                android:layout_weight="1"
                android:background="@drawable/rounded_button_request"
                android:onClick="buRequestEvent"
                android:text="@string/request" />

        <Button
                android:onClick="buAcceptEvent"
                android:layout_marginStart="3pt"
                android:background="@drawable/rounded_button_accept"
                android:id="@+id/buAcceptEvent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/accept" />

        <!-- Кнопка меню заменена на выпадающее меню -->
        <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3pt"
                android:background="@drawable/rounded_button_request"
                android:contentDescription="Меню"
                android:src="@android:drawable/ic_menu_more" />
    </LinearLayout>

    <!-- Индикатор загрузки -->
    <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:indeterminate="true"
            android:visibility="gone" />

    <!-- Статус подключения -->
    <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/connecting"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:visibility="visible" />

    <!-- Оверлей "Нет интернета" - блокирует весь экран -->
    <FrameLayout
            android:id="@+id/noInternetOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:elevation="10dp">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:background="@drawable/rounded_button_accept">

            <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    android:contentDescription="No internet icon"
                    android:layout_marginBottom="16dp"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Нет подключения к интернету"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Проверьте настройки сети и попробуйте снова"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp"
                    android:gravity="center"/>
        </LinearLayout>
    </FrameLayout>

    <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/whitebackground"
            android:gravity="center"
            android:layout_gravity="center">

        <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3pt"
                android:gravity="center">

            <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/bu1"
                    android:layout_width="40pt"
                    android:layout_height="40pt"
                    android:layout_marginRight="3pt"
                    android:background="@color/white"
                    android:onClick="buClick"/>

            <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/bu2"
                    android:layout_width="40pt"
                    android:layout_height="40pt"
                    android:layout_marginRight="3pt"
                    android:background="@color/white"
                    android:onClick="buClick"/>

            <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/bu3"
                    android:layout_width="40pt"
                    android:layout_height="40pt"
                    android:background="@color/white"
                    android:onClick="buClick"/>
        </TableRow>

        <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3pt"
                android:gravity="center">

            <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/bu4"
                    android:layout_width="40pt"
                    android:layout_height="40pt"
                    android:layout_marginRight="3pt"
                    android:background="@color/white"
                    android:onClick="buClick"/>

            <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/bu5"
                    android:layout_width="40pt"
                    android:layout_height="40pt"
                    android:layout_marginRight="3pt"
                    android:background="@color/white"
                    android:onClick="buClick"/>

            <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/bu6"
                    android:layout_width="40pt"
                    android:layout_height="40pt"
                    android:background="@color/white"
                    android:onClick="buClick"/>
        </TableRow>

        <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center">

            <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/bu7"
                    android:layout_width="40pt"
                    android:layout_height="40pt"
                    android:layout_marginRight="3pt"
                    android:background="@color/white"
                    android:onClick="buClick"/>

            <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/bu8"
                    android:layout_width="40pt"
                    android:layout_height="40pt"
                    android:layout_marginRight="3pt"
                    android:background="@color/white"
                    android:onClick="buClick"/>

            <Button
                    style="?android:attr/buttonBarButtonStyle"
                    android:id="@+id/bu9"
                    android:layout_width="40pt"
                    android:layout_height="40pt"
                    android:background="@color/white"
                    android:onClick="buClick"/>
        </TableRow>
    </TableLayout>

    <de.hdodenhof.circleimageview.CircleImageView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/image_View_user2"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_fire_emoji"
            app:civ_border_width="2dp"
            app:civ_border_overlay="true"
            app:civ_border_color="#FF000000" 
            android:layout_gravity="center"
            android:visibility="gone"/>
    <TextView
            android:text="@string/player2_enemy_name"
            android:layout_width="80dp"
            android:layout_height="wrap_content" 
            android:id="@+id/player2_text_View" 
            android:textAlignment="center"
            android:textStyle="bold" 
            android:textSize="12sp" 
            android:layout_gravity="center"
            android:visibility="gone"/>
</LinearLayout>