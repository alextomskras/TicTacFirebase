{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "$userId === auth.uid || root.child('users').child($userId).child('email').val() === auth.token.email"
      }
    },
    "PlayerOnline": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
